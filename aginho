let atual = 0;
let pontos = 0;

function iniciarQuiz(){
document.getElementById("principal").style.display="none";
document.getElementById("quiz").style.display="block";
mostrarPergunta();
}

function mostrarPergunta(){

if(atual >= perguntas.length){

document.getElementById("quiz").innerHTML = `
<div class="card">
<h1>🏆 Quiz Finalizado!</h1>
<h2>${nomeUsuario}, você fez ${pontos} de ${perguntas.length} pontos.</h2>

<p>${
pontos >= 6
? "🌱 Excelente! Você entende muito sobre Agro Forte e Sustentabilidade."
: "📚 Continue estudando para proteger o futuro do planeta."
}</p>

<button onclick="location.reload()">Jogar Novamente</button>
</div>
`;

return;
}

let perguntaAtual = perguntas[atual];

document.getElementById("pergunta").innerHTML =
`${atual+1}/${perguntas.length}<br><br>${perguntaAtual.pergunta}`;

let html = "";

perguntaAtual.opcoes.forEach((opcao,index)=>{
html += `
<button class="opcao" onclick="responder(${index})">
${String.fromCharCode(65+index)}. ${opcao}
</button>
`;
});

document.getElementById("alternativas").innerHTML = html;
document.getElementById("resultado").innerHTML = "";
}

function responder(indice){

let perguntaAtual = perguntas[atual];

if(indice === perguntaAtual.correta){

pontos++;

document.getElementById("resultado").innerHTML =
`<div style="background:#14532d;padding:15px;border-radius:10px;border:2px solid #22c55e;">
✅ Resposta correta!<br><br>
${perguntaAtual.explicacao}
</div>`;

}else{

document.getElementById("resultado").innerHTML =
`<div style="background:#7f1d1d;padding:15px;border-radius:10px;border:2px solid #ef4444;">
❌ Resposta incorreta!<br><br>
${perguntaAtual.explicacao}
</div>`;
}

document.getElementById("pontos").innerHTML =
"⭐ Pontos: " + pontos;

atual++;

setTimeout(()=>{
mostrarPergunta();
},4000);

}